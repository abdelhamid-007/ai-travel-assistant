# --- LLM (any OpenAI-compatible server; defaults to local Ollama) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama

# --- Telegram ---
# Create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
# Only these Telegram user ids may use the bot (comma separated). Empty = everyone.
TELEGRAM_ALLOWED_USERS=
# Channel/chat the Publisher posts to (bot must be an admin), e.g. @mychannel
TELEGRAM_CHANNEL_ID=

# --- Other platforms (TikTok, Instagram, YouTube) via n8n / Make / Postiz ---
WEBHOOK_URL=

# UTC offset of your audience, used to pick best posting hours
TZ_OFFSET_HOURS=1
