# PostgreSQL with pgvector (same database as the other projects). For Neon, keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Your Vapi PRIVATE key: dashboard.vapi.ai -> API Keys
VAPI_API_KEY=

# Any long random string you invent. Vapi sends it back on every tool call so the server
# can reject requests that do not come from Vapi. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(16))"
VAPI_SECRET=

# Written automatically by create_assistant.py after the first run
VAPI_ASSISTANT_ID=
